resources
| where type =~ 'microsoft.compute/disks'
| extend vmId = tostring(managedBy)
| extend VmName = tostring(split(vmId, '/virtualMachines/')[1])
| join kind=leftouter (
    resources
    | where type =~ 'microsoft.network/networkinterfaces'
    | extend attachedVmId = tostring(properties.virtualMachine.id)
    | where isnotempty(attachedVmId)
    | extend vnetId = tostring(properties.ipConfigurations[0].properties.subnet.id)
    | extend vnetName = tostring(split(vnetId, '/')[8])
    | project attachedVmId, vnetName
) on $left.vmId == $right.attachedVmId
| join kind=leftouter (
    resourcecontainers
    | where type =~ 'microsoft.resources/subscriptions'
    | project subscriptionName = name, subscriptionId
) on subscriptionId
| extend azureRegion = location
| extend azureZone = strcat_array(zones, '"')
| extend resourceId = tolower(tostring(id))
| extend resourceName = name
| extend diskName = name
| extend diskType = sku.name
| extend osDisk = properties.osType
| extend diskSize = tostring(properties.diskSizeGB)
| extend diskState = tostring(properties.diskState)
| extend diskBW = tostring(properties.diskMBpsReadWrite)
| extend diskIOPS = tostring(properties.diskIOPSReadWrite)
| extend createdDateTime = properties.timeCreated
| where isnull(properties.osType)
| summarize arg_min(diskName, *) by diskName
| join kind=leftouter (
    resources
    | where type =~ 'microsoft.compute/snapshots'
    | extend sourceDiskId = tolower(tostring(properties.creationData.sourceResourceId))
    | extend snapDiskSizeGB = toreal(properties.diskSizeGB)
    | extend isIncremental = tobool(properties.incremental)
    | summarize
        snapshotCount = count(),
        snapshotBilledCapacityGB = sumif(snapDiskSizeGB, isIncremental == false),
        snapshotProvisionedCapacityGB = sum(snapDiskSizeGB),
        incrementalSnapshotCount = countif(isIncremental == true)
        by sourceDiskId
) on $left.resourceId == $right.sourceDiskId
| extend snapshotCount = coalesce(snapshotCount, 0)
| extend snapshotBilledCapacityGB = coalesce(snapshotBilledCapacityGB, 0.0)
| extend snapshotProvisionedCapacityGB = coalesce(snapshotProvisionedCapacityGB, 0.0)
| extend incrementalSnapshotCount = coalesce(incrementalSnapshotCount, 0)
| project azureRegion, azureZone, subscriptionName, resourceGroup, resourceId, resourceName,
    diskName, diskType, osDisk, diskSize, diskBW, diskIOPS, diskState, managedBy, createdDateTime,
    VmName, vnetName, snapshotCount, incrementalSnapshotCount, snapshotBilledCapacityGB, snapshotProvisionedCapacityGB
